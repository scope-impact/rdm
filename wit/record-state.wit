package rdm:component@0.1.0;

/// The repository state RDM's gates read: what git would say of the record.
/// Exported by rdm-git (gitoxide); imported by the core.
interface record-state {
    /// A path relative to the repository root, which every RDM component sees at /.
    type repo-path = string;
    type commit-id = string;

    /// Adding a case changes the encoding: a new major version of this package.
    enum tracking { tracked, untracked, ignored, skip-worktree, assume-unchanged }

    record file-state {
        path: repo-path,
        tracking: tracking,
        /// The index differs from the last commit.
        staged: bool,
        /// The working tree differs from the index.
        modified: bool,
    }

    record head-state {
        commit: option<commit-id>,
        origin: option<string>,
        dirty: bool,
        merging: bool,
    }

    /// None when the record's state cannot be known (not a repository): never approved.
    head: func() -> option<head-state>;
    /// A path may be a directory: every file under it. None when it cannot be known.
    files: func(paths: list<repo-path>) -> option<list<file-state>>;
    /// Whether some commit holds, at this path, exactly what is staged.
    staged-in-history: func(path: repo-path) -> bool;

    // History, for the graph (rdm graph build): who changed the record, when, and where it landed.

    record commit-info {
        id: commit-id,
        author: string,
        /// The author's time, as git's %aI writes it (strict ISO 8601, with the offset).
        time: string,
        subject: string,
    }

    record reference {
        target: commit-id,
        /// The reference it names, when it is symbolic (refs/remotes/origin/HEAD -> refs/remotes/origin/main).
        symbolic: option<string>,
    }

    /// Each path's latest commit, as `git log -1 -- <path>` finds it; a path no commit has is left out.
    latest-commits: func(paths: list<repo-path>) -> list<tuple<repo-path, commit-id>>;
    /// A commit named by its id or a revision (HEAD, a branch).
    commit: func(revision: string) -> option<commit-info>;
    /// A full reference name (refs/heads/main), resolved.
    resolve: func(name: string) -> option<reference>;
    /// The local branches, by short name.
    branches: func() -> list<string>;
    /// A configuration value (init.defaultBranch).
    config: func(key: string) -> option<string>;
    /// `git rev-list --first-parent <revision>`: newest first.
    first-parents: func(revision: string) -> list<commit-id>;
    /// `git rev-list --ancestry-path <ancestor>..<revision>`: the commits on a path from one to the other.
    ancestry-path: func(ancestor: commit-id, revision: string) -> list<commit-id>;
}
