;; The harness configuration: everything the harness must not know by heart.
;; Everything here is committed, so nothing machine-local belongs here.
{;; Stamped scenario ids are @<id-prefix>-NNNN.
 :id-prefix {{id-prefix}}

 ;; Where the spec, the id ledger, the C4 model, the event catalogue and the
 ;; user needs live.
 :spec-dir "dhf/spec"
 :ledger "dhf/spec/ids.edn"
 :model "dhf/spec/model.edn"
 :events "dhf/spec/events.edn"
 :needs "dhf/spec/needs.edn"
 ;; Generated views.
 :views-dir "dhf/views"

 ;; The raw sources every need cites, and the domain wiki.
 :raw-dir "dhf/raw"
 :wiki-dir "dhf/wiki"
 ;; The words neither the wiki nor the spec may use: the stack, which lives in
 ;; dhf/harness/stack.md.
 :stack-words []

 ;; Where the step definitions for "rdm-spec run" live, and where test
 ;; results are written and read.
 :steps-dir "test/steps"
 :results-dir "dhf/allure-results"

 ;; Cycles: dhf/cycles/NN/cycle.edn, written by hand, and what the cycle's
 ;; tasks write beside it.
 :cycles-dir "dhf/cycles"

 ;; The site: written under :source, built into :dir.
 :site {:dir "site" :source "site-src" :builder ["mkdocs" "build" "--strict" "-f" "site-src/mkdocs.yml"]}

 ;; The clean room is the cut minus what is denied: the implementation a
 ;; regeneration rebuilds (its paths, :implementation and :code-layout, and
 ;; the builder's :test-command are added when there is an implementation),
 ;; the measurements and the generated output. Every committed top-level path
 ;; and every path directly under dhf/ is denied or kept, or rdm-spec check
 ;; fails.
 :clean-room {:deny {:implementation true
                     :measurements ["dhf/cycles"]
                     :generated ["site" "site-src" "dhf/allure-results"]}
              :keep ["dhf/spec" "dhf/harness" "dhf/raw" "dhf/wiki" "dhf/views" "dhf/decisions"
                     ".gitignore" ".githooks" ".github"]}

 ;; What rdm-spec verify proves about a build, in order, the first failure
 ;; stopping it: the tests check first, always, then any :serves or :runs
 ;; check. Name the command that runs your tests, writing Allure results into
 ;; the directory RESULTS_DIR names: {:kind :tests :command ["..."]}.
 :verify [{:kind :tests}]

 ;; Observing a run: the directories whose entries are compared before and
 ;; after it ("~" is the home directory), and the temporary directory whose
 ;; entries are counted.
 :agency {:watch ["/" "~"] :tmp "/tmp"}}
