#!/usr/bin/env bb
;; The pre-commit hook, installed by rdm-spec: every commit is checked. It runs
;; "rdm-spec check" and refuses the commit unless the check exits 0.
(require '[babashka.process :as p])

(defn- say [& xs] (binding [*out* *err*] (apply println "pre-commit:" xs)))

(let [code (try (:exit @(p/process ["rdm-spec" "check"] {:inherit true}))
                (catch Exception e
                  (say "rdm-spec check could not be run:" (ex-message e))
                  2))]
  (when-not (zero? code)
    (say (str "rdm-spec check exited " code "; the commit is refused")))
  (System/exit code))
