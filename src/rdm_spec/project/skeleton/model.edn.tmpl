;; The C4 model of {{name}}: the one source every architecture view is
;; generated from ("rdm-spec views"). Written by rdm-spec init with the system
;; and nothing else; add the people, external systems, containers, bounded
;; contexts, components, relationships and views as the design is found.
;;
;; Shape; ids are keywords, unique across the model, components namespaced by
;; their context.
;;
;;   :system         {:id :name :description}
;;   :people         [{:id :name :description :actor #{:human :agent}}]
;;   :external       [{:id :name :description}]
;;   :containers     [{:id :name :description :technology :kind :runs | :stores
;;                     :contexts [{:id :name :description
;;                                 :components [{:id :name :description
;;                                               :spec "<context>/<component>"}]}]}]
;;                   ; a component owns dhf/spec/<spec>.feature
;;   :relationships  [{:from :to :description [:event]}]
;;                   ; :event names one in events.edn
;;   :views          [{:key :level :description [:context] [:steps]}]
{:system {:id {{system-id}}
          :name {{name-edn}}
          :description "Describe what the system does"}
 :people []
 :external []
 :containers []
 :relationships []
 :views []}
