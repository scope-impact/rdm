-- The user needs of this context: one surface per need.

-- An auditor can identify the current approved revision of any controlled document, who approved it, and its complete change history.
surface CurrentRevision {
    facing user: Auditor

    @guarantee CurrentRevision
}

-- The document control system satisfies the applicable 21 CFR Part 11 controls for electronic records and electronic signatures.
surface Part11Controls {
    facing user: Auditor

    @guarantee Part11Controls
}
