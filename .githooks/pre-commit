#!/usr/bin/env bash
#
# Design-controls gate (IEC 62304 / ISO 13485 7.3 / 21 CFR 820.30).
#
# Blocks a commit that introduces IMPLEMENTATION work unless the design input
# and design review are complete and approved (committed) in version control.
#
# Committing only the design documents themselves is allowed -- that commit is
# how the design gets approved. This keeps the gate enforced for everyday work
# while avoiding a chicken-and-egg deadlock: you could never approve the design
# docs if their own commit were blocked for being "uncommitted".
#
# Configuration (environment variables):
#   RDM_DHF_DIR              design history file directory   (default: dhf)
#   RDM_WORK_PATTERN         regex (ERE, matched in any case) of staged paths
#                            that count as implementation work (default:
#                            source/template/config extensions and build files)
#   RDM_WORK_EXCLUDE         regex of staged paths that never count (default:
#                            only the DHF itself and the planning directory —
#                            a whole-directory exemption is a gate hole, so
#                            e.g. docs/ build hooks and CI workflows ARE gated)
#   RDM_SKIP_DESIGN_GATE=1   bypass the gate for this commit (discouraged)
#
set -euo pipefail

DHF_DIR="${RDM_DHF_DIR:-dhf}"
WORK_PATTERN="${RDM_WORK_PATTERN:-(\.(pyi?|ya?ml|toml|json|ini|cfg|conf|properties|env|xml|j2|jinja2|html?|vue|svelte|sh|bash|zsh|ps1|psm1|bat|cmd|[cm]?jsx?|[cm]?tsx?|c|h|cc|cpp|cxx|hh|hpp|cs|fs|go|java|kt|kts|scala|groovy|rs|swift|m|mm|rb|php|pl|r|jl|dart|lua|sql|cmake|gradle|mk|tf|hcl|proto)|(^|/)(Dockerfile|Containerfile|Makefile|GNUmakefile|Jenkinsfile|Vagrantfile|Gemfile|Rakefile)(\.[^/]*)?)$}"
WORK_EXCLUDE="${RDM_WORK_EXCLUDE:-^(${DHF_DIR}|backlog)/}"

if [ -n "${RDM_SKIP_DESIGN_GATE:-}" ]; then
    echo "rdm design-gate: BYPASSED via RDM_SKIP_DESIGN_GATE" >&2
    exit 0
fi

# Staged additions, changes, renames, copies and type changes (ignoring
# deletions), excluding the DHF itself and the planning directory. Names are
# read NUL-separated, exactly as written: git would quote a name holding a tab
# or a double quote, and the quotes would hide its extension. Extensions match
# in any case (app.PY is Python too).
shopt -s nocasematch
work=""
while IFS= read -r -d '' path; do
    if [[ $path =~ $WORK_PATTERN ]] && ! [[ $path =~ $WORK_EXCLUDE ]]; then
        work+="$path"$'\n'
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMRT)
shopt -u nocasematch

# No implementation work staged -> nothing to gate (e.g. authoring/approving the
# design documents, or editing docs and config).
[ -z "$work" ] && exit 0

# Resolve the gate runner. A missing runner BLOCKS the commit: silently skipping
# the gate is exactly the failure mode this hook exists to prevent.
if command -v rdm >/dev/null 2>&1; then
    RDM=(rdm)
elif command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then
    RDM=(uv run rdm)
else
    echo "rdm design-gate: 'rdm' not on PATH and no 'uv' + pyproject.toml to fall back to." >&2
    echo "                 Install it: uv tool install \"rdm @ git+https://github.com/scope-impact/rdm\"" >&2
    echo "                 (PyPI's 'rdm' is another project), or uv sync in RDM's own repository" >&2
    echo "                 -- commit blocked. (RDM_SKIP_DESIGN_GATE=1 to bypass, discouraged)" >&2
    exit 1
fi

if [ ! -d "$DHF_DIR" ]; then
    echo "rdm design-gate: '$DHF_DIR' not found; run 'rdm init' or set RDM_DHF_DIR" >&2
    echo "                 (or RDM_SKIP_DESIGN_GATE=1 to bypass)" >&2
    exit 1
fi

if ! output="$("${RDM[@]}" story design-gate --dhf "$DHF_DIR" 2>&1)"; then
    echo "$output" >&2
    echo "" >&2
    echo "rdm design-gate: commit blocked -- complete and approve (commit) the design" >&2
    echo "                 input and design review before committing implementation work." >&2
    echo "                 (RDM_SKIP_DESIGN_GATE=1 to bypass)" >&2
    exit 1
fi

exit 0
