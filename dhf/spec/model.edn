;; rdm-spec's C4 model: the one source every architecture view is generated from
;; (dhf/decisions/adr-0002-spec-first-regeneration.md). From the first event
;; storm (dhf/storm/2026-10-24-rdm.md), revised by its decided hotspots and by
;; two independent reviews.
;;
;; rdm-spec is a modular monolith: one runnable container, the rdm-spec
;; command, made of bounded contexts that are composable rather than separately
;; run. A context is drawn as a boundary around its components (the C4 skill:
;; bounded contexts as boundaries around C4 elements). Composable means each
;; context can be regenerated alone while the others stand, and the whole still
;; ratifies.
;;
;; Shape; ids are keywords, unique across the model, components namespaced by
;; their context.
;;
;;   :system         {:id :name :description}
;;   :people         [{:id :name :description :actor #{:human :agent}}]
;;                   ; a role, filled by a human, an agent, or either
;;   :external       [{:id :name :description}]
;;   :containers     [{:id :name :description :technology :kind :runs | :stores
;;                     :contexts [{:id :name :description
;;                                 :components [{:id :name :description
;;                                               :spec "<context>/<component>"}]}]}]
;;                   ; :contexts only on a :runs container; dhf/spec/<spec>.feature
;;   :kernel         [{:id :name :description :spec "kernel/<component>"}]
;;                   ; shared code of the rdm-spec container, in no context: the command,
;;                   ; the bus and the runner
;;   :relationships  [{:from :to :description [:event]}]
;;                   ; :event names one in events.edn; events travel only within one run
;;   :views          [{:key :level :description [:context] [:steps]}]
{:system {:id :rdm-spec-system
          :name "rdm-spec"
          :description "Regenerates a build from its spec, scores it"}

 :people
 [{:id :engineer :name "Engineer" :actor #{:human :agent}
   :description "Writes the spec and its architecture"}
  {:id :reviewer :name "Reviewer" :actor #{:human :agent}
   :description "Approves each spec change"}
  {:id :builder :name "Builder" :actor #{:human :agent}
   :description "Regenerates the build in a clean room"}
  {:id :grader :name "Grader" :actor #{:human :agent}
   :description "Grades a ratified build, never their own"}
  {:id :spec-owner :name "Spec owner" :actor #{:human :agent}
   :description "Decides what the spec must learn next"}]

 :external
 [{:id :git-host :name "Git host"
   :description "Holds merges and pull requests"}
  {:id :test-runner :name "Test runner"
   :description "Runs step definitions, writes Allure results"}]

 :containers
 [{:id :rdm-spec :name "rdm-spec" :kind :runs :technology "Command-line program; the stack is in dhf/harness/stack.md"
   :description "The one command: bounded contexts in one program, meeting on an in-process bus"
   :contexts
   [{:id :project :name "project"
      :description "Sets a repository up in this structure and installs the hook and the cut workflow"
      :components
      [{:id :project/init :name "Init" :spec "project/init"
        :description "Writes a new project's skeleton into a path that does not exist"}
       {:id :project/adopt :name "Adopt" :spec "project/adopt"
        :description "Adds the skeleton to an existing repository, never overwriting a file"}
       {:id :project/hooks :name "Hooks" :spec "project/hooks"
        :description "Installs the pre-commit hook that runs rdm-spec check"}]}

     {:id :spec :name "spec"
      :description "Reads the spec, stamps scenario ids and checks the spec's rules"
      :components
      [{:id :spec/parser :name "Parser" :spec "spec/parser"
        :description "Reads the declared Gherkin subset and refuses anything outside it"}
       {:id :spec/stamper :name "Stamper" :spec "spec/stamper"
        :description "Hands out scenario ids from the ledger, never twice"}
       {:id :spec/check :name "Spec check" :spec "spec/check"
        :description "Ids, levels, tags, needs, citations, planned work and no stack words"}]}

     {:id :knowledge :name "knowledge"
      :description "Keeps the raw sources and the domain wiki, and checks every citation"
      :components
      [{:id :knowledge/sources :name "Sources" :spec "knowledge/sources"
        :description "Reads the provenance records and resolves citations against their pins"}
       {:id :knowledge/wiki :name "Wiki" :spec "knowledge/wiki"
        :description "The domain wiki: every page indexed, every claim footnoted to a source"}]}

     {:id :architecture :name "architecture"
      :description "Reads the C4 model, lints it, and generates and checks its views"
      :components
      [{:id :architecture/model :name "Model" :spec "architecture/model"
        :description "Reads model.edn and the event catalogue"}
       {:id :architecture/lint :name "Lint" :spec "architecture/lint"
        :description "The C4 skill's checklist and the bounded-context rules"}
       {:id :architecture/views :name "Views" :spec "architecture/views"
        :description "Generates each view as diagram source and renders it"}]}

     {:id :verification :name "verification"
      :description "Derives each scenario's status from Allure results and traces it"
      :components
      [{:id :verification/results :name "Results reader" :spec "verification/results"
        :description "Reads a run's Allure results, naming what it cannot read"}
       {:id :verification/status :name "Status" :spec "verification/status"
        :description "Verified, failed, unverified or planned, for every stamped scenario"}
       {:id :verification/trace :name "Trace" :spec "verification/trace"
        :description "A need or scenario with everything linked to it"}
       {:id :verification/release :name "Release check" :spec "verification/release"
        :description "Refuses a release with an unverified, failed or planned scenario"}]}

     {:id :regeneration :name "regeneration"
      :description "Cuts merged spec changes and builds clean rooms from them, for the project, one context or one component"
      :components
      [{:id :regeneration/cut :name "Cut" :spec "regeneration/cut"
        :description "Tags HEAD spec-N when it is origin/HEAD, and pushes the tag"}
       {:id :regeneration/fence :name "Fence" :spec "regeneration/fence"
        :description "Builds a clean room from a cut: the allowed paths and the code its scope keeps"}]}

     {:id :ratification :name "ratification"
      :description "Ratifies a build against its cut: the builder's tests pass, write results and name every scenario"
      :components
      [{:id :ratification/ratify :name "Ratify" :spec "ratification/ratify"
        :description "Puts the room's implementation into a checkout of the cut and runs the builder's tests"}]}

     {:id :measurement :name "measurement"
      :description "Derives the checklist, files a grader's verdicts and compares cycles, never for the builder"
      :components
      [{:id :measurement/checklist :name "Checklist" :spec "measurement/checklist"
        :description "One item per stamped scenario at the cut, into checklist.json"}
       {:id :measurement/scorer :name "Scorer" :spec "measurement/scorer"
        :description "Files a grader's verdicts, and nothing when nothing was graded"}
       {:id :measurement/scoreboard :name "Scoreboard" :spec "measurement/scoreboard"
        :description "Better and worse over shared items, a moved denominator said aloud"}]}

     {:id :publishing :name "publishing"
      :description "Publishes the spec, its views and its status as one site"
      :components
      [{:id :publishing/site :name "Site" :spec "publishing/site"
        :description "One page per component and context, and the site builder's configuration"}]}]}

  {:id :repository :name "Repository" :kind :stores :technology "git"
   :description "The spec, the model, the ledger, cuts, cycles and results"}]

 :kernel
 [{:id :kernel/command :name "Command" :spec "kernel/command"
   :description "The rdm-spec command: dispatches each task to the context that owns it"}
  {:id :kernel/bus :name "Event bus" :spec "kernel/bus"
   :description "Delivers each catalogued event to its subscribers, within one run"}
  {:id :kernel/runner :name "Gherkin runner" :spec "kernel/runner"
   :description "Runs the scenarios' steps and writes Allure results"}]

 :relationships
 [;; people and external systems
  {:from :engineer :to :rdm-spec :description "Writes, checks and publishes the spec with"}
  {:from :reviewer :to :git-host :description "Approves spec merges in"}
  {:from :builder :to :rdm-spec :description "Builds a clean room and is ratified by"}
  {:from :grader :to :rdm-spec :description "Grades each checklist item of a ratified build for"}
  {:from :spec-owner :to :rdm-spec :description "Reads the scoreboard from"}
  {:from :rdm-spec :to :git-host :description "Tags cuts on merges in"}
  {:from :rdm-spec :to :test-runner :description "Runs the declared test command through"}
  {:from :test-runner :to :repository :description "Writes Allure results to"}
  {:from :rdm-spec :to :repository :description "Reads the spec and writes views, cycles, scores and the site to"}

  ;; components and the store: how steps that run at different times meet
  {:from :project/init :to :repository :description "Writes the skeleton to"}
  {:from :project/adopt :to :repository :description "Adds the skeleton to"}
  {:from :spec/stamper :to :repository :description "Stamps features and advances the ledger in"}
  {:from :architecture/views :to :repository :description "Writes views to"}
  {:from :regeneration/cut :to :repository :description "Tags merges spec-N in"}
  {:from :regeneration/fence :to :repository :description "Builds clean rooms from cuts in"}
  {:from :ratification/ratify :to :repository :description "Reads cycle.edn and the cut, writes the cycle's results to"}
  {:from :measurement/checklist :to :repository :description "Writes checklist.json to"}
  {:from :measurement/scorer :to :repository :description "Reads cycle.edn, the checklist and verdicts, writes score.edn to"}
  {:from :measurement/scoreboard :to :repository :description "Reads scores from"}
  {:from :publishing/site :to :repository :description "Reads views from and writes the site to"}

  ;; events between contexts, within one run: the contracts
  {:from :knowledge/sources :to :spec/check :description "Publishes" :event :KnowledgeIndexed}
  {:from :knowledge/sources :to :publishing/site :description "Publishes" :event :KnowledgeIndexed}
  {:from :spec/parser :to :architecture/lint :description "Publishes" :event :SpecParsed}
  {:from :spec/parser :to :verification/status :description "Publishes" :event :SpecParsed}
  {:from :spec/parser :to :measurement/checklist :description "Publishes" :event :SpecParsed}
  {:from :spec/parser :to :publishing/site :description "Publishes" :event :SpecParsed}
  {:from :spec/check :to :publishing/site :description "Publishes" :event :SpecGated}
  {:from :verification/status :to :publishing/site :description "Publishes" :event :VerificationDerived}

  ;; within contexts
  {:from :project/adopt :to :project/hooks :description "Installs hooks with"}
  {:from :project/init :to :project/hooks :description "Installs hooks with"}
  {:from :project/hooks :to :kernel/command :description "Runs rdm-spec check through"}
  {:from :spec/stamper :to :spec/parser :description "Reads scenarios with"}
  {:from :spec/check :to :spec/parser :description "Reads scenarios with"}
  {:from :knowledge/wiki :to :knowledge/sources :description "Resolves footnotes with"}
  {:from :architecture/lint :to :architecture/model :description "Checks"}
  {:from :architecture/views :to :architecture/model :description "Generates views from"}
  {:from :verification/status :to :verification/results :description "Derives statuses from"}
  {:from :verification/trace :to :verification/status :description "Reads statuses from"}
  {:from :verification/release :to :verification/status :description "Refuses on"}
  {:from :regeneration/fence :to :regeneration/cut :description "Builds clean rooms only from"}
  {:from :measurement/scorer :to :measurement/checklist :description "Scores"}
  {:from :measurement/scoreboard :to :measurement/scorer :description "Compares the filed scores of"}]

 :views
 [{:key "context" :level :context
   :description "rdm-spec, the people who use it and the systems around it"}
  {:key "containers" :level :container
   :description "The one command and the repository it reads and writes"}
  {:key "project-components" :level :component :context :project
   :description "Setting a repository up"}
  {:key "spec-components" :level :component :context :spec
   :description "Reading, stamping and checking the spec"}
  {:key "knowledge-components" :level :component :context :knowledge
   :description "The raw sources and the domain wiki"}
  {:key "architecture-components" :level :component :context :architecture
   :description "The C4 model, its lint and its views"}
  {:key "verification-components" :level :component :context :verification
   :description "From Allure results to status, trace and the release check"}
  {:key "regeneration-components" :level :component :context :regeneration
   :description "The cut and the fence"}
  {:key "ratification-components" :level :component :context :ratification
   :description "Ratifying a build"}
  {:key "measurement-components" :level :component :context :measurement
   :description "The checklist, the score and the scoreboard"}
  {:key "publishing-components" :level :component :context :publishing
   :description "The published site"}
  {:key "regeneration-cycle" :level :dynamic
   :description "One cycle, from a merged spec change to a score the spec owner reads"
   :steps [[:regeneration/cut :repository "1. Tags the merge spec-N"]
           [:regeneration/fence :repository "2. Builds the clean room from the cut"]
           [:ratification/ratify :repository "3. Ratifies the room's implementation against the cut"]
           [:grader :rdm-spec "4. Grades each checklist item of the ratified build"]
           [:measurement/scorer :repository "5. Files the verdicts into score.edn"]
           [:spec-owner :rdm-spec "6. Reads the scoreboard"]]}]}
