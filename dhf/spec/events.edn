;; The event catalogue: the domain events that pass between bounded contexts,
;; which are the contracts between them. A relationship in model.edn that
;; publishes an event must name one declared here, from its declared publisher
;; (rule c4-events-named, dhf/spec/architecture/lint.feature).
;;
;; Events travel on the in-process bus (kernel/bus), so only within one run of
;; the rdm-spec command. Steps that run at different times (cut, fence, ratify,
;; score) meet through files instead: the spec-N tag, the clean room, the
;; cycle's cycle.edn and results directory (the model's store relationships).
{:KnowledgeIndexed
 {:description "The raw sources and the wiki were read: every pinned source, every page, and which citations resolve"
  :published-by :knowledge/sources
  :carries [:revision :sources :pages :citations :findings]}

 :SpecParsed
 {:description "The spec at a revision was read: every scenario with its id, tags, steps and owning component"
  :published-by :spec/parser
  :carries [:revision :scenarios :needs :refusals]}

 :SpecGated
 {:description "The spec at a revision passed or failed the spec check, with every finding"
  :published-by :spec/check
  :carries [:revision :passed? :findings]}


 :VerificationDerived
 {:description "Each scenario's status (verified, failed, unverified, planned) was derived from a run's Allure results"
  :published-by :verification/status
  :carries [:revision :statuses :unknown-results :unreadable-files]}}
