// Slice 04, model the architecture
// (dhf/spec/04-model-the-architecture/plan.md): one C4 model whose views are
// generated and checked, and whose components own the scenarios.
//
// Exports the interfaces of the components whose home is this slice (their
// model spec path names it: architecture/model, architecture/lint,
// architecture/views), the slice's tasks (tasks.wit: views, the
// architecture/views component's), which rdm-spec.wac wires to the command's
// import model-the-architecture (tasks.wit, later-slices), and check's two
// stages this slice builds, model-lint-stage (architecture/lint's) and
// views-stage (architecture/views'), which rdm-spec.wac wires by name into
// slice 02's imports of them (spec-check.wit, check-stages), ahead of the
// not-built stand-in's spread. Imports the host's processes, for the
// renderer. It imports no other slice: slice 02 imports its stages, so an
// import of slice 02 would be a cycle no composition can wire
// (dhf/spec/02-write-the-spec/decisions.md, ED-02).
//
// WASI is named by no world of this slice, as in slice 02: the cycle that
// builds the slice adds the line slice 01's worlds carry, in the version they
// carry (dhf/spec/04-model-the-architecture/decisions.md, ED-08).
// Composed by slice-04.wac.

world model-the-architecture {
    import rdm:host/process@0.1.0;
    export architecture-model;
    export architecture-lint;
    export architecture-views;
    export tasks;
    export model-lint-stage: interface {
        record event { name: string, published-by: string, edn: string }
        record finding { file: option<string>, line: option<u32>, rule: string, message: string, warning: bool }
        record request { args: list<string>, folder: option<string>, events: list<event> }
        record answer { findings: list<finding>, published: list<event>, reported: option<string> }
        run: func(request: request) -> option<result<answer, string>>;
    }
    export views-stage: interface {
        record event { name: string, published-by: string, edn: string }
        record finding { file: option<string>, line: option<u32>, rule: string, message: string, warning: bool }
        record request { args: list<string>, folder: option<string>, events: list<event> }
        record answer { findings: list<finding>, published: list<event>, reported: option<string> }
        run: func(request: request) -> option<result<answer, string>>;
    }
}
