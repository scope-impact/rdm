// Kernel component Command (dhf/spec/model.edn, :kernel/command;
// dhf/spec/01-start-a-project/command.feature,
// dhf/spec/11-project-in-a-folder/command.feature): the rdm-spec command,
// the one entry point. It holds the task table and help, dispatches each task
// to the slice whose tasks name it (tasks.wit), and owns how every task
// reports (dhf/spec/README.md, "How every task reports").
//
// Its interface holds the command's own types: the findings and the refusal
// it reports. No slice's interface uses them: a type used from another
// interface is an instance import, and the command imports every slice's
// tasks, so a slice importing the command's types would be a cycle no
// composition can wire (ED-14). A slice reports through tasks' outcome. The
// command is reached through wasi:cli/run.

interface kernel-command {
    /// One line of the error stream: "FILE:LINE: RULE: what", FILE and LINE
    /// left out where none applies (spec-0178); a warning when warning is true
    /// ("FILE:LINE: warning: RULE: what").
    record finding {
        file: option<string>,
        line: option<u32>,
        rule: string,
        message: string,
        warning: bool,
    }

    /// A task that cannot run as asked: exit 2, "cannot-run: why" on the
    /// error stream, nothing on standard output (spec-0179, spec-0180).
    record cannot-run {
        why: string,
    }
}

/// The component kernel/command builds to: the command's entry point.
/// It holds the task table, every row of spec-0176 in its order, and help,
/// the table's first row, answered by the command itself whatever is built.
/// It exports slice 01's tasks (help, init, adopt), running init and adopt
/// with project/init and project/adopt, and imports every later slice's tasks
/// (tasks.wit, later-slices). A task of the table is run by the slice whose
/// entries name it; a task no built slice names answers that it is not built
/// (exit 2); a task not in the table is unknown (exit 2, spec-0180).
world kernel-command-component {
    include wasi:cli/imports@0.2.3;
    include later-slices;
    import project-init;
    import project-adopt;
    export kernel-command;
    export tasks;
    export wasi:cli/run@0.2.3;
}
