;; rdm-spec's own harness configuration: everything the harness must not know by
;; heart. A difference between projects lives here, declared, and nowhere in
;; the harness code. Each value is used by a component specified under
;; dhf/spec/, named beside it; decided in
;; dhf/decisions/adr-0002-spec-first-regeneration.md. Everything here is
;; committed, so nothing machine-local belongs here: source checkouts, for one,
;; are given on the command line (rdm-spec check --sources DIR).
{;; Stamped scenario ids are @<id-prefix>-NNNN (dhf/spec/02-write-the-spec/stamper.feature).
 :id-prefix "spec"

 ;; Where the product spec, the id ledger and the C4 model live.
 :spec-dir "dhf/spec"
 ;; The spec is grouped by slice, then by component (ADR 0004;
 ;; dhf/spec/04-model-the-architecture/model.feature): <NN-slice>/plan.md
 ;; and <NN-slice>/<component>.feature, a component found by its name.
 :spec-layout :slices
 :ledger "dhf/spec/ids.edn"
 :model "dhf/spec/model.edn"
 :events "dhf/spec/events.edn"
 :needs "dhf/spec/needs.edn"
 ;; Generated views (dhf/spec/04-model-the-architecture/views.feature).
 :views-dir "dhf/views"

 ;; The raw sources every need cites (dhf/raw/README.md,
 ;; dhf/spec/03-ground-the-spec/sources.feature).
 :raw-dir "dhf/raw"

 ;; The domain wiki, and the words no page of it may use
 ;; (dhf/spec/03-ground-the-spec/wiki.feature).
 :wiki-dir "dhf/wiki"
 ;; The words neither the wiki nor the spec may use: the stack, which lives in
 ;; dhf/harness/stack.md (dhf/spec/02-write-the-spec/check.feature).
 :stack-words ["Babashka" "Clojure" "Python" "Mermaid" "mmdr" "MkDocs" "GitHub Actions" "pytest"
                "Rust" "Cargo" "WebAssembly" "WASI" "wasmtime"
                "Pandoc" "Typst" "pdftotext" "ORAS"]

 ;; Where a project's step definitions for "rdm-spec run" live
 ;; (dhf/spec/05-verify-by-results/runner.feature). rdm-spec's own are the builder's, under
 ;; test/: implementation, rebuilt with the code, never scored.
 :steps-dir "test/steps"

 ;; The implementation: every path a regeneration rebuilds, and where each
 ;; context's and component's code and unit tests live, so one context or one
 ;; component can be rebuilt while the rest stands
 ;; (dhf/spec/06-regenerate/fence.feature). test.clj runs the tests.
 :implementation ["src" "test" "test.clj" "bb.edn" "wasm"]
 ;; {component} is written with - as _, as Clojure file names are. Each entry
 ;; is a path prefix: a scope removes every implementation file starting with
 ;; one of its entries, the step definitions included.
 :code-layout {:context ["src/rdm_spec/{context}/" "test/rdm_spec/{context}/"
                         "test/steps/{context}_" "wasm/components/{context}-"]
               :component ["src/rdm_spec/{context}/{component}.clj"
                           "test/rdm_spec/{context}/{component}_test.clj"
                           "test/steps/{context}_{component}.clj"
                           "wasm/components/{context}-{component}/"]}

 ;; The clean room is the cut minus what is denied (dhf/spec/regeneration/
 ;; fence.feature), as Löyly's fence is the repository minus every
 ;; implementation and measurement. Every committed top-level path, and every
 ;; path directly under dhf/, is denied or kept here, or `rdm-spec check`
 ;; fails. The instrument's goldens are not in the repository at all: see
 ;; :plugins.
 ;; The project's plugins (dhf/spec/08-plugins/plugins.feature; ADR 0003), in the
 ;; order they run. The oracle is the plugin named "oracle", answering :Gate
 ;; (dhf/spec/08-plugins/oracle.feature; glossary "Oracle (instrument)"): held
 ;; still, outside the implementation, never regenerated. dhf/harness/oracle/
 ;; holds the tool, its README and pin.edn, the artifact of its goldens.
 :plugins [{:name "oracle" :answers :Gate :command ["bb" "dhf/harness/oracle/oracle.clj"]}]

 :clean-room {;; :implementation is the scope's implementation (see :implementation and
              ;; :code-layout); the measurements are every cycle's record; the
              ;; generated output is what publish and the tests write.
              :deny {:implementation true
                     :measurements ["dhf/cycles"]
                     :generated ["site" "site-src" "dhf/allure-results"]}
              :keep [".gitignore" "AGENTS.md" "CLAUDE.md" "LICENSE.txt" "README.md" "docs"
                     "dhf/decisions" "dhf/harness" "dhf/raw" "dhf/spec" "dhf/storm"
                     "dhf/views" "dhf/wiki" "dhf/wit" "plugins"]}

 ;; Observe (dhf/spec/07-measure/observe.feature): the directories whose entries are
 ;; compared before and after a run ("~" is the home directory), and the
 ;; temporary directory whose entries are counted.
 :agency {:watch ["/" "~"] :tmp "/tmp"}

 ;; What ratify runs in a checkout of the cut holding the room's implementation
 ;; (dhf/spec/ratification/ratify.feature): the builder's own tests, written
 ;; from the spec, writing Allure results labelled with scenario ids into the
 ;; directory given as RESULTS_DIR. They gate; they are never the score.
 ;; What verify proves (dhf/spec/06-regenerate/verify.feature; glossary,
 ;; "Check"), in order, the first failure stopping it. rdm-spec is a command,
 ;; so it has no :serves check: its tests, then the command answering.
 ;; Since ADR 0006 the build verified is the WebAssembly one, growing slice by
 ;; slice in wasm/: its tests, then its command answering.
 :verify [{:kind :tests :command ["sh" "wasm/test.sh"]}
          {:kind :runs :name "answers" :command ["sh" "wasm/rdm-spec" "help"]
           :expect {:exit 0 :stdout-starts "{:help"} :budget {:seconds 30}}]
 :results-dir "dhf/allure-results"

 ;; Cycles: dhf/cycles/NN/ holds cycle.edn (written by hand), results/, build/
 ;; and ratified.edn (ratify), checklist.json (checklist) and score.edn (score,
 ;; from a grader's verdicts)
 ;; (dhf/spec/measurement/).
 :cycles-dir "dhf/cycles"

 ;; The site (dhf/spec/09-publish/site.feature): MkDocs builds it, strictly, so
 ;; a broken link fails the build.
 :site {:dir "site" :source "site-src" :builder ["mkdocs" "build" "--strict" "-f" "site-src/mkdocs.yml"]}

 ;; C4 lint (dhf/spec/04-model-the-architecture/lint.feature).
 :c4 {:view-element-limit 20
      ;; People and systems only: mmdr overlaps a longer description with the
      ;; name (@spec-0009).
      :description-max-chars 45}}
