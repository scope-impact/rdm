;; rdm-spec's own harness configuration: everything the harness must not know by
;; heart. A difference between projects lives here, declared, and nowhere in
;; the harness code. Each value is used by a component specified under
;; dhf/spec/, named beside it; decided in
;; dhf/decisions/adr-0002-spec-first-regeneration.md. Everything here is
;; committed, so nothing machine-local belongs here: source checkouts, for one,
;; are given on the command line (rdm-spec check --sources DIR).
{;; Stamped scenario ids are @<id-prefix>-NNNN (dhf/spec/spec/stamper.feature).
 :id-prefix "spec"

 ;; Where the product spec, the id ledger and the C4 model live.
 :spec-dir "dhf/spec"
 :ledger "dhf/spec/ids.edn"
 :model "dhf/spec/model.edn"
 :events "dhf/spec/events.edn"
 :needs "dhf/spec/needs.edn"
 ;; Generated views (dhf/spec/architecture/views.feature).
 :views-dir "dhf/views"

 ;; The raw sources every need cites (dhf/raw/README.md,
 ;; dhf/spec/knowledge/sources.feature).
 :raw-dir "dhf/raw"

 ;; The domain wiki, and the words no page of it may use
 ;; (dhf/spec/knowledge/wiki.feature).
 :wiki-dir "dhf/wiki"
 ;; The words neither the wiki nor the spec may use: the stack, which lives in
 ;; dhf/harness/stack.md (dhf/spec/spec/check.feature).
 :stack-words ["Babashka" "Clojure" "Python" "Mermaid" "mmdr" "MkDocs" "GitHub Actions" "pytest"
                "Pandoc" "Typst" "pdftotext"]

 ;; Where a project's step definitions for "rdm-spec run" live
 ;; (dhf/spec/kernel/runner.feature). rdm-spec's own are the builder's, under
 ;; test/: implementation, rebuilt with the code, never scored.
 :steps-dir "test/steps"

 ;; The implementation: every path a regeneration rebuilds, and where each
 ;; context's and component's code and unit tests live, so one context or one
 ;; component can be rebuilt while the rest stands
 ;; (dhf/spec/regeneration/fence.feature). test.clj runs the tests.
 :implementation ["src" "test" "test.clj" "bb.edn"]
 ;; {component} is written with - as _, as Clojure file names are. Each entry
 ;; is a path prefix: a scope removes every implementation file starting with
 ;; one of its entries, the step definitions included.
 :code-layout {:context ["src/rdm_spec/{context}/" "test/rdm_spec/{context}/"
                         "test/steps/{context}_"]
               :component ["src/rdm_spec/{context}/{component}.clj"
                           "test/rdm_spec/{context}/{component}_test.clj"
                           "test/steps/{context}_{component}.clj"]}

 ;; The clean room is an allow-list (dhf/spec/regeneration/fence.feature): these
 ;; paths, plus the implementation a scoped regeneration keeps, and nothing
 ;; else. Giving the builder no network is the builder's obligation.
 ;; dhf/harness is allowed file by file: its oracle/ holds the instrument's
 ;; goldens, the measurements a builder of the instrument must never see
 ;; (loyly:harness/README.md@17d68d2, "The idea in five lines" 2; Löyly fences
 ;; its own harness/oracle, dhf/raw/sources.edn).
 :clean-room {:allow ["dhf/spec" "dhf/harness/config.edn" "dhf/harness/stack.md"
                      "dhf/raw" "dhf/wiki" "dhf/views"
                      "dhf/decisions/adr-0002-spec-first-regeneration.md"]}

 ;; What ratify runs in a checkout of the cut holding the room's implementation
 ;; (dhf/spec/ratification/ratify.feature): the builder's own tests, written
 ;; from the spec, writing Allure results labelled with scenario ids into the
 ;; directory given as RESULTS_DIR. They gate; they are never the score.
 :test-command ["bb" "test.clj"]
 :results-dir "dhf/allure-results"

 ;; Cycles: dhf/cycles/NN/ holds cycle.edn (written by hand), results/, build/
 ;; and ratified.edn (ratify), checklist.json (checklist) and score.edn (score,
 ;; from a grader's verdicts)
 ;; (dhf/spec/measurement/).
 :cycles-dir "dhf/cycles"

 ;; The site (dhf/spec/publishing/site.feature): MkDocs builds it, strictly, so
 ;; a broken link fails the build.
 :site {:dir "site" :source "site-src" :builder ["mkdocs" "build" "--strict" "-f" "site-src/mkdocs.yml"]}

 ;; C4 lint (dhf/spec/architecture/lint.feature).
 :c4 {:view-element-limit 20
      ;; People and systems only: mmdr overlaps a longer description with the
      ;; name (@spec-0009).
      :description-max-chars 45}}
