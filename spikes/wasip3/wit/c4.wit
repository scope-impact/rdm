package rdm:component@0.1.0;

/// The C4 workspace, exported and drawn: what `rdm c4 draw` needs.
/// Exported by rdm-c4 (structurizrx); imported by the core.
interface c4 {
    /// A path relative to the repository root, which every RDM component sees at /.
    type repo-path = string;

    record view {
        key: string,
        svg: string,
    }

    record drawing {
        /// Structurizr's workspace JSON, with each element's DSL identifier.
        workspace-json: string,
        views: list<view>,
    }

    /// Parse and draw the workspace at `dsl`, a file the component can read.
    draw: func(dsl: repo-path) -> result<drawing, string>;
}
