#!/usr/bin/env bash
#
# Spike: the rdm command line as WASI components (rdm.wasm: the CLI composed
# with rdm-git and rdm-c4; build.sh).
#   spikes/wasip3/rdm-wasm story design-gate --dhf dhf
#
# Needs Wasmtime on the host, nothing else: no Python, no RDM, no git, no
# Java, no Graphviz. Run it from the repository's root; the components see
# that directory under its own name (/<name>, so RDM names the project as it
# does natively) and start there, may write in it as rdm does, see RDM's
# package data at /2/rdm, and have no network. RDM_GIT_TRACE=1 prints each
# git question and answer.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
WORK="$HERE/.work"
WASM="${RDM_WASM:-$WORK/rdm.wasm}"
DATA="${RDM_WASM_DATA:-$WORK/rdm-data}"   # build.sh copies RDM's package data here
WASMTIME="${WASMTIME:-$WORK/wasmtime}"

REPO="/$(basename "$PWD")"
args=()   # paths given relative to here are the same inside; absolute ones move under $REPO
for arg in "$@"; do
    case "$arg" in "$PWD"/*) args+=("$REPO/${arg#"$PWD"/}") ;; "$PWD") args+=("$REPO") ;; *) args+=("$arg") ;; esac
done
exec "$WASMTIME" run -S tcp=n,udp=n,allow-ip-name-lookup=n \
    --dir "$PWD::$REPO" --dir "$DATA::/2/rdm" --env RDM_REPO="$REPO" --env RDM_GIT_TRACE="${RDM_GIT_TRACE:-}" \
    "$WASM" "${args[@]}"
