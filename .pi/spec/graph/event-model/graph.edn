;; .pi/spec/graph/event-model/graph.edn: the commands of the graph context and the events
;; they produce. Allium: ../allium/graph.allium (rules GraphBuild, GraphValidate,
;; ExplorerFile, ServeAgent).
{:graph
 {:commands
  {:graph/build
   {:description "Project the record into its named graphs and replace the store (rdm graph build). Issued by: regulatory author."
    :grain/allium [{:spec ".pi/spec/graph/allium/graph.allium" :kind :rule :name "GraphBuild"}]
    :produces #{:graph/graph-built}}
   :graph/validate
   {:description "Validate the gate shapes, and any supplied, over the projection (rdm graph validate). Issued by: regulatory author, or CI."
    :grain/allium [{:spec ".pi/spec/graph/allium/graph.allium" :kind :rule :name "GraphValidate"}]
    :produces #{:graph/graph-validated}}
   :graph/explorer-file
   {:description "Write the graph as an AWS Graph Explorer file (rdm graph explorer-file). Issued by: regulatory author."
    :grain/allium [{:spec ".pi/spec/graph/allium/graph.allium" :kind :rule :name "ExplorerFile"}]
    :produces #{:graph/explorer-file-written}}
   :graph/serve-agent
   {:description "Serve the record to an agent over stdio (rdm graph mcp). Issued by: agent harness."
    :grain/allium [{:spec ".pi/spec/graph/allium/graph.allium" :kind :rule :name "ServeAgent"}]
    :produces #{:graph/agent-served}}
   :graph/query
   {:description "Answer a SPARQL query over the store or a fresh projection (rdm graph query). Issued by: regulatory author."
    :produces #{:graph/query-answered}}
   :graph/serve
   {:description "Serve the store as a read-only SPARQL endpoint (rdm graph serve). Issued by: regulatory author."
    :produces #{:graph/store-served}}}
  :events
  {:graph/graph-built {:description "The record was projected and the store replaced."}
   :graph/graph-validated {:description "The shapes were validated over the projection; each result reported."}
   :graph/explorer-file-written {:description "The graph was written as a Graph Explorer file."}
   :graph/agent-served {:description "An agent read the record through the read-only tools."}
   :graph/query-answered {:description "A SPARQL query was answered."}
   :graph/store-served {:description "The store was served read-only to a graph browser."}}}}
