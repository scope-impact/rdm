;; .pi/spec/specification/event-model/scaffolding.edn: the commands of the specification
;; context and the events they produce. Allium: ../allium/scaffolding.allium (rules Init,
;; Adopt). A validation record is a reviewed file in dhf/validation, not a command.
{:specification
 {:commands
  {:specification/init
   {:description "Scaffold a new documentation project into a directory that does not yet exist (rdm init). Issued by: regulatory author."
    :grain/allium [{:spec ".pi/spec/specification/allium/scaffolding.allium" :kind :rule :name "Init"}]
    :produces #{:specification/project-scaffolded}}
   :specification/adopt
   {:description "Bring an existing repository under RDM, skipping what exists (rdm adopt). Issued by: regulatory author."
    :grain/allium [{:spec ".pi/spec/specification/allium/scaffolding.allium" :kind :rule :name "Adopt"}]
    :produces #{:specification/repository-adopted}}}
  :events
  {:specification/project-scaffolded {:description "A new documentation project was laid down from the templates."}
   :specification/repository-adopted {:description "An existing repository was brought under RDM; what existed was skipped and reported."}}}}
