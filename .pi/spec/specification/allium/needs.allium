-- RDM's user needs in this context: one surface per need.

-- A reviewer can see, at release, which user needs have no approved validation by a person.
surface ValidationVisible {
    facing user: Reviewer

    @guarantee ValidationVisible
        -- A reviewer can see, at release, which user needs have no approved validation by a person.
}

-- A regulatory author can scaffold a new compliant documentation project from a single command.
surface ScaffoldProject {
    facing user: RegulatoryAuthor

    @guarantee ScaffoldProject
        -- A regulatory author can scaffold a new compliant documentation project from a single command.
}

-- An existing repository can be brought under RDM from a single command, without disturbing its current contents.
surface AdoptRepository {
    facing user: Team

    @guarantee AdoptRepository
        -- An existing repository can be brought under RDM from a single command, without disturbing its current contents.
}
