-- RDM's user needs in this context: one surface per need.

-- A regulatory author can compile a design history file from the system of record: the spec, the executed tests and git.
surface CompileDhf {
    facing user: RegulatoryAuthor

    @guarantee CompileDhf
        -- A regulatory author can compile a design history file from the system of record: the spec, the executed tests and git.
}

-- A user learns from RDM's user manual, a controlled document of each release, how to keep the record the way that release's gates enforce.
surface UserManual {
    facing user: User

    @guarantee UserManual
        -- A user learns from RDM's user manual, a controlled document of each release, how to keep the record the way that release's gates enforce.
}
