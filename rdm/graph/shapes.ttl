@prefix rdm:     <https://github.com/scope-impact/rdm/ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# The gate rules as SHACL (DI-38): closed-world checks over the open-world
# graph. sh:Violation = release-blocking (mirrors `rdm story release-gate` and
# `rdm gap`); sh:Warning = what the design gate reports as a warning.
# Teams add their own rules as more shape files: `rdm graph validate --shapes`.

# --- Release gate -----------------------------------------------------------

rdm:UserNeedAddressedShape a sh:NodeShape ;
    sh:targetClass rdm:UserNeed ;
    sh:property [
        sh:path [ sh:inversePath rdm:tracesTo ] ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "user need is addressed by no design input" ;
    ] .

rdm:DesignInputVerifiedShape a sh:NodeShape ;
    sh:targetClass rdm:DesignInput ;
    # At least one passing run...
    sh:property [
        sh:path [ sh:inversePath rdm:exercises ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path rdm:status ; sh:hasValue "passed" ] ] ;
        sh:qualifiedMinCount 1 ;
        sh:severity sh:Violation ;
        sh:message "design input is not verified by any passing test run" ;
    ] ;
    # ...and no failed or broken one.
    sh:property [
        sh:path [ sh:inversePath rdm:exercises ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path rdm:status ; sh:in ( "failed" "broken" ) ] ] ;
        sh:qualifiedMaxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "design input has a failed or broken test run" ;
    ] .

# --- Gap analysis (rdm gap) -------------------------------------------------

rdm:ClauseReferencedShape a sh:NodeShape ;
    sh:targetClass rdm:Clause ;
    sh:property [
        sh:path [ sh:inversePath dcterms:references ] ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "checklist clause is referenced by no document" ;
    ] .

# Checklist data itself, whichever file it came from (.txt or RDF).
rdm:ClauseDataShape a sh:NodeShape ;
    sh:targetClass rdm:Clause ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:severity sh:Violation ; sh:message "clause needs exactly one key (skos:notation)" ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:class skos:ConceptScheme ;
                  sh:severity sh:Violation ; sh:message "clause needs a standard (skos:inScheme a skos:ConceptScheme)" ] .

rdm:ChecklistDataShape a sh:NodeShape ;
    sh:targetClass rdm:Checklist ;
    sh:property [ sh:path skos:member ; sh:class rdm:Clause ;
                  sh:severity sh:Violation ; sh:message "checklist member is not a clause" ] ;
    sh:property [ sh:path rdm:includes ; sh:class rdm:Checklist ;
                  sh:severity sh:Violation ; sh:message "checklist includes something that is not a checklist" ] .

# --- Design gate warnings ---------------------------------------------------

rdm:DesignInputTaggedShape a sh:NodeShape ;
    sh:targetClass rdm:DesignInput ;
    sh:property [
        sh:path [ sh:inversePath rdm:verifies ] ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "design input has no tagged test file" ;
    ] ;
    sh:property [
        sh:path rdm:tracesTo ; sh:class rdm:UserNeed ;
        sh:severity sh:Warning ; sh:message "design input traces to an undeclared user need" ;
    ] .

rdm:ContextReferencesShape a sh:NodeShape ;
    sh:targetClass rdm:BoundedContext ;
    sh:property [ sh:path rdm:realises ; sh:class rdm:DesignInput ;
                  sh:severity sh:Warning ; sh:message "context realises an undeclared design input" ] .

# The projection marks the tags the design gate warns about (rdm.record.ids.
# relevant_orphans): only those sharing a declared input's id prefix.
rdm:TestTagShape a sh:NodeShape ;
    sh:targetClass rdm:Test ;
    # A SPARQL constraint takes its severity from the shape (pySHACL ignores
    # it on the constraint node).
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "test tag {?tag} names no declared design input" ;
        sh:prefixes rdm: ;
        sh:select """SELECT $this ?tag WHERE { $this rdm:undeclaredTag ?tag }""" ;
    ] .

# The risk register's release rules (DI-44, DI-45): the same risks the
# release gate blocks. The residual decision is computed by the gate's own
# function (rdm/risk/register.py), so the two cannot drift.
rdm:RiskShape a sh:NodeShape ;
    # The risk rules are written once, in rdm/risk/register.py; the projection
    # carries the release gate's findings on each risk (DI-45), so the shapes
    # block exactly what the gate blocks.
    sh:targetClass rdm:Risk ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "{?finding}" ;
        sh:select """SELECT $this ?finding WHERE { $this rdm:finding ?finding }""" ;
    ] .

# DI-46: an id the record declares more than once.
rdm:UniqueRequirementShape a sh:NodeShape ;
    sh:targetClass rdm:UserNeed, rdm:DesignInput ;
    sh:property [ sh:path rdm:declarationCount ; sh:maxInclusive 1 ;
                  sh:message "id is declared more than once in the record" ] .

# DI-51: a design document whose latest change is not on the default branch.
rdm:LandedShape a sh:NodeShape ;
    sh:targetClass rdm:Document ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "document's latest change has not landed on the default branch" ;
        sh:select """SELECT $this WHERE {
            $this <http://www.w3.org/ns/prov#wasGeneratedBy> ?c .
            FILTER NOT EXISTS { $this rdm:landedIn ?l } }""" ;
    ] .

rdm:RiskWarningShape a sh:NodeShape ;
    sh:targetClass rdm:Risk ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "{?warning}" ;
        sh:select """SELECT $this ?warning WHERE { $this rdm:riskWarning ?warning }""" ;
    ] .

rdm:ContextDeclaredShape a sh:NodeShape ;
    sh:targetClass rdm:BoundedContext ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "bounded context has a design document but no document declares it (contexts frontmatter)" ;
        sh:select """SELECT $this WHERE {
            ?doc rdm:describes $this .
            FILTER NOT EXISTS { $this rdm:declaredIn ?d }
            FILTER EXISTS { ?other a rdm:BoundedContext ; rdm:declaredIn ?any } }""" ;
    ] .

rdm:DocumentReferenceShape a sh:NodeShape ;
    sh:targetClass rdm:Document ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "references a document the record does not hold" ;
        sh:select """SELECT $this ?value WHERE {
            $this dcterms:references ?value .
            FILTER(STRSTARTS(STR(?value), CONCAT(STRBEFORE(STR($this), ":doc/"), ":doc/")))
            FILTER NOT EXISTS { ?value a rdm:Document } }""" ;
    ] .

# --- Evidence tied to its version and to its test (DI-60, DI-61) -------------

rdm:RunVersionShape a sh:NodeShape ;
    sh:targetClass rdm:TestRun ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "test run is tied to no commit: the version it is evidence for is unknown" ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this rdm:testedAt ?c } }""" ;
    ] , [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "test run tested another commit than the record's: stale evidence" ;
        sh:select """SELECT $this WHERE {
            $this rdm:testedAt ?tested . ?record rdm:atCommit ?head .
            FILTER (?tested != ?head) }""" ;
    ] , [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "test run exercises a design input its test does not claim" ;
        sh:select """SELECT $this WHERE {
            $this rdm:runOf ?test ; rdm:exercises ?input .
            FILTER NOT EXISTS { ?test rdm:verifies ?input } }""" ;
    ] .

rdm:TestRanShape a sh:NodeShape ;
    sh:targetClass rdm:Test ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "tagged test has no run, while other tests in its file ran: its claim was never executed" ;
        sh:select """SELECT $this WHERE {
            $this rdm:definedIn ?file .
            FILTER NOT EXISTS { ?run rdm:runOf $this }
            FILTER EXISTS { ?other rdm:definedIn ?file . ?any rdm:runOf ?other } }""" ;
    ] .

rdm: sh:declare
    [ sh:prefix "rdm" ; sh:namespace "https://github.com/scope-impact/rdm/ns#"^^xsd:anyURI ] ,
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] .

# --- The C4 model against the record (DI-68): warnings, never violations ----

rdm:DesignOutputComponentShape a sh:NodeShape ;
    sh:targetClass rdm:SourceFile ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "design output is in no component's code" ;
        sh:select """SELECT $this WHERE {
            ?run rdm:exercisesOutput $this .
            FILTER NOT EXISTS { $this rdm:inComponent ?c }
            FILTER EXISTS { ?any a rdm:Component } }""" ;
    ] .

rdm:RunContextShape a sh:NodeShape ;
    sh:targetClass rdm:TestRun ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "test run exercises a component of {?context}, which neither owns nor realises {?input}" ;
        sh:select """SELECT DISTINCT $this ?context ?input WHERE {
            $this rdm:exercises ?di ; rdm:exercisesOutput/rdm:inComponent/rdm:inContext ?ctx .
            BIND (REPLACE(STR(?ctx), "^.*[:/]context/", "") AS ?context) ?di rdfs:label ?input .
            FILTER NOT EXISTS { ?di rdm:ownedBy ?ctx }
            FILTER NOT EXISTS { ?ctx rdm:realises ?di } }""" ;
    ] .

rdm:DependencyDeclaredShape a sh:NodeShape ;
    sh:targetClass rdm:Dependency ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "code dependency with no relationship declared from the one component to the other" ;
        sh:select """SELECT $this WHERE {
            $this rdm:source ?s ; rdm:target ?t .
            FILTER NOT EXISTS { ?r a rdm:Relationship ; rdm:source ?s ; rdm:target ?t } }""" ;
    ] .

rdm:ComponentShape a sh:NodeShape ;
    sh:targetClass rdm:Component ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "component's group {?group} is not a bounded context the architecture declares" ;
        sh:select """SELECT $this ?group WHERE {
            $this rdm:inContext ?ctx . BIND (REPLACE(STR(?ctx), "^.*[:/]context/", "") AS ?group)
            FILTER NOT EXISTS { ?ctx rdm:declaredIn ?d }
            FILTER EXISTS { ?declared rdm:declaredIn ?any ; a rdm:BoundedContext } }""" ;
    ] , [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "component's code path {?path} does not exist" ;
        sh:select """SELECT $this ?path WHERE { $this rdm:missingCode ?path }""" ;
    ] .

rdm:ContextArchitectureShape a sh:NodeShape ;
    sh:targetClass rdm:BoundedContext ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "bounded context has no component in the architecture" ;
        sh:select """SELECT $this WHERE {
            $this rdm:declaredIn ?d .
            FILTER NOT EXISTS { ?c rdm:inContext $this }
            FILTER EXISTS { ?any a rdm:Component } }""" ;
    ] , [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "bounded context's design document does not show its component view {?view}" ;
        sh:select """SELECT $this ?view WHERE {
            ?doc rdm:describes $this . $this rdfs:label ?name .
            FILTER EXISTS { ?c rdm:inContext $this }
            BIND (CONCAT("C3_", ?name) AS ?view)
            FILTER NOT EXISTS { ?doc rdm:showsView ?view } }""" ;
    ] .

rdm:RelationshipShape a sh:NodeShape ;
    sh:targetClass rdm:Relationship ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ; sh:prefixes rdm: ;
        sh:message "relationship has no description" ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this dcterms:description ?d } }""" ;
    ] .
