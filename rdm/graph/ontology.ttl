@prefix rdm:     <https://github.com/scope-impact/rdm/ns#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# RDM's vocabulary for the design record as a graph (item-06-001). Standard terms are
# reused where they exist -- OSLC Requirements Management for requirements,
# Dublin Core for document metadata, PROV-O for commits and authors -- and an
# rdm: term is minted only where none fits.

rdm: a owl:Ontology ;
    rdfs:label "RDM design-record vocabulary" ;
    rdfs:comment "Classes and properties for a medical-device design history file projected from RDM's Markdown record." .

# --- Classes ----------------------------------------------------------------

rdm:UserNeed a owl:Class ;
    rdfs:label "User need" ;
    rdfs:comment "What an actor needs, as the spec captures it: a screen of the event model with the Allium surfaces it links (who it faces, the rules it provides, what it guarantees), and the event-storm events behind it; a surface, in a context with no screens." .

rdm:Requirement a owl:Class ;
    rdfs:subClassOf oslc_rm:Requirement ;
    rdfs:label "Requirement" ;
    rdfs:comment "A stamped scenario of the spec (item-NN-SSS): one acceptance criterion, verified by the test runs that claim it." .

rdm:AlliumRule a owl:Class ;
    rdfs:label "Allium rule" ;
    rdfs:comment "A rule of the spec's Allium: the behaviour a trigger has, with its refusals." .

rdm:BoundedContext a owl:Class ;
    rdfs:label "Bounded context" ;
    rdfs:comment "A unit of design: one context of the spec (a slice of its plan)." .

rdm:Document a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Controlled document" ;
    rdfs:comment "A document with a frontmatter id, under version control." .

rdm:Record a owl:Class ;
    rdfs:label "Record" ;
    rdfs:comment "The design record the graph was built from (item-06-016)." .

rdm:TestRun a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Test run" ;
    rdfs:comment "One executed test, as reported in an Allure result." .

# Gap analysis (item-06-003). Checklists are data, never classes: a new standard is
# a new skos:ConceptScheme instance, a new checklist a new rdm:Checklist
# instance -- loaded from a file, with no change to this vocabulary.

rdm:Clause a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Checklist clause" ;
    rdfs:comment "One requirement of a standard, as a checklist item: skos:notation is its key (e.g. 62304:5.6.2), skos:definition its description, skos:inScheme its standard, skos:broader its parent clause." .

rdm:Checklist a owl:Class ;
    rdfs:subClassOf skos:Collection ;
    rdfs:label "Checklist" ;
    rdfs:comment "A named selection of clauses: skos:member lists its own items, rdm:includes the checklists it includes; its effective contents are rdm:includes*/skos:member." .

skos:ConceptScheme rdfs:label "Standard" ;
    rdfs:comment "A standard or regulation whose clauses checklists select from, named by the key prefix (62304, P11, FDA-SW, ...)." .

prov:Activity rdfs:label "Activity" .
prov:Agent rdfs:label "Agent" .

# --- Properties -------------------------------------------------------------

rdm:text a owl:DatatypeProperty ;
    rdfs:label "text" ; rdfs:comment "What a user need or requirement says: a screen's description, a scenario's title." ; rdfs:range xsd:string .

rdm:tracesTo a owl:ObjectProperty ;
    rdfs:label "traces to" ; rdfs:domain rdm:Requirement ; rdfs:range rdm:UserNeed ;
    rdfs:comment "A user need a requirement addresses: one whose rules or guarantees it covers, else each need of its own context." .

rdm:addresses a owl:ObjectProperty ;
    rdfs:label "addresses" ; rdfs:domain rdm:Requirement ; rdfs:range rdm:UserNeed ;
    rdfs:comment "A user need the spec's needs source links the requirement to directly: the Feature it sits under, or (Allium adapter) a need whose rules or guarantees it covers. A need no requirement addresses blocks a release." .

rdm:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by" ; rdfs:range rdm:BoundedContext ;
    rdfs:comment "The context of the spec a requirement, user need or rule belongs to." .

rdm:source a owl:DatatypeProperty ;
    rdfs:label "source" ; rdfs:comment "The spec file (and line) a fact is read from, from the repository root." .

rdm:inRule a owl:DatatypeProperty ;
    rdfs:label "in rule" ; rdfs:domain rdm:Requirement ; rdfs:comment "The Gherkin Rule the scenario sits under." .

rdm:covers a owl:DatatypeProperty ;
    rdfs:label "covers" ; rdfs:domain rdm:Requirement ;
    rdfs:comment "An Allium obligation the scenario is tagged with, as kind.Name (rule-success.DeriveChecklist)." .

rdm:coversRule a owl:ObjectProperty ;
    rdfs:label "covers rule" ; rdfs:domain rdm:Requirement ; rdfs:range rdm:AlliumRule .

rdm:facing a owl:DatatypeProperty ;
    rdfs:label "facing" ; rdfs:domain rdm:UserNeed ; rdfs:comment "An actor the need's surfaces face." .

rdm:surface a owl:DatatypeProperty ;
    rdfs:label "surface" ; rdfs:domain rdm:UserNeed ; rdfs:comment "An Allium surface of the need." .

rdm:providesRule a owl:ObjectProperty ;
    rdfs:label "provides rule" ; rdfs:domain rdm:UserNeed ; rdfs:range rdm:AlliumRule ;
    rdfs:comment "A rule whose trigger a surface of the need provides." .

rdm:guarantee a owl:DatatypeProperty ;
    rdfs:label "guarantee" ; rdfs:domain rdm:UserNeed ; rdfs:comment "A guarantee a surface of the need makes." .

rdm:command a owl:DatatypeProperty ;
    rdfs:label "command" ; rdfs:domain rdm:UserNeed ; rdfs:comment "A command the need's screen issues (event model)." .

rdm:stormEvent a owl:DatatypeProperty ;
    rdfs:label "storm event" ; rdfs:domain rdm:UserNeed ;
    rdfs:comment "An event-storm event an actor causes that a command of the screen produces, with its actor." .

rdm:trigger a owl:DatatypeProperty ;
    rdfs:label "trigger" ; rdfs:domain rdm:AlliumRule ; rdfs:comment "The trigger the rule answers (its when:)." .

rdm:declaredIn a owl:ObjectProperty ;
    rdfs:label "declared in" ; rdfs:range rdm:Document .

rdm:part a owl:DatatypeProperty ;
    rdfs:label "part" ; rdfs:domain rdm:BoundedContext ;
    rdfs:comment "The part of the product (Record, Gates, Graph, Documents...) the architecture assigns a context to (item-06-015)." .

rdm:describes a owl:ObjectProperty ;
    rdfs:label "describes" ; rdfs:domain rdm:Document ; rdfs:range rdm:BoundedContext .

rdm:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ; rdfs:domain rdm:Document .

rdm:path a owl:DatatypeProperty ;
    rdfs:label "path" ; rdfs:comment "Repository-relative path." .

rdm:testedAt a owl:ObjectProperty ;
    rdfs:label "tested at" ; rdfs:domain rdm:TestRun ; rdfs:range prov:Activity ;
    rdfs:comment "The commit under test: the version the run is evidence for (item-06-016)." .

rdm:uncommittedChanges a owl:DatatypeProperty ;
    rdfs:label "uncommitted changes" ; rdfs:domain rdm:TestRun ;
    rdfs:comment "The run tested a working tree with changes not in its commit (item-06-016)." .

rdm:atCommit a owl:ObjectProperty ;
    rdfs:label "at commit" ; rdfs:domain rdm:Record ; rdfs:range prov:Activity ;
    rdfs:comment "The commit the record was at when the graph was built (item-06-016)." .

rdm:productAt a owl:ObjectProperty ;
    rdfs:label "product at" ; rdfs:domain rdm:Record ; rdfs:range prov:Activity ;
    rdfs:comment "The commit of the product the evidence must be for: of the repository the spec lives in, the record's own when they are one (item-06-016)." .

rdm:exercises a owl:ObjectProperty ;
    rdfs:label "exercises" ; rdfs:domain rdm:TestRun ; rdfs:range rdm:Requirement ;
    rdfs:comment "A requirement the run claims with an Allure tag item-NN-SSS. A claim, not a verdict." .

rdm:landedIn a owl:ObjectProperty ; rdfs:label "landed in" ; rdfs:domain rdm:Document ; rdfs:range prov:Activity ;
    rdfs:comment "The first-parent commit of the default branch that brought the document's latest change in (a merge, squash or direct commit). Git records who landed a change, not who reviewed it." .
rdm:landedBy a owl:ObjectProperty ; rdfs:label "landed by" ; rdfs:domain rdm:Document ; rdfs:range prov:Agent ;
    rdfs:comment "The author of the landing commit." .
rdm:evaluatedAgainst a owl:ObjectProperty ; rdfs:label "evaluated against" ; rdfs:range rdm:Document ;
    rdfs:comment "The document holding the risk policy the risk was evaluated against." .

rdm:Step a owl:Class ;
    rdfs:label "Test step" ;
    rdfs:comment "One Allure step of a test run, in order, nested under its parent step (item-06-013)." .
rdm:Attachment a owl:Class ;
    rdfs:label "Attachment" ;
    rdfs:comment "Evidence a test run or step attached: a file in the Allure results (item-06-013)." .
rdm:step a owl:ObjectProperty ; rdfs:label "step" ; rdfs:range rdm:Step ;
    rdfs:comment "From a test run or a step to a step it contains." .
rdm:attachment a owl:ObjectProperty ; rdfs:label "attachment" ; rdfs:range rdm:Attachment ;
    rdfs:comment "From a test run or a step to evidence it attached." .
rdm:position a owl:DatatypeProperty ; rdfs:label "position" ; rdfs:domain rdm:Step ;
    rdfs:comment "The step's place in the run: 1, 2, 2.1 ..." .

rdm:SourceFile a owl:Class ;
    rdfs:label "Source file" ;
    rdfs:comment "A file a test run exercises, named by its output label." .
rdm:Parameter a owl:Class ; rdfs:label "Parameter" ;
    rdfs:comment "One parameter of a parametrised run: a name and a value (item-06-014)." .
rdm:parameter a owl:ObjectProperty ; rdfs:label "parameter" ; rdfs:domain rdm:TestRun ; rdfs:range rdm:Parameter .
rdm:name a owl:DatatypeProperty ; rdfs:label "name" .
rdm:value a owl:DatatypeProperty ; rdfs:label "value" .
rdm:fullName a owl:DatatypeProperty ; rdfs:label "full name" ; rdfs:domain rdm:TestRun .
rdm:statusMessage a owl:DatatypeProperty ; rdfs:label "status message" .
rdm:statusTrace a owl:DatatypeProperty ; rdfs:label "status trace" .
rdm:exercisesOutput a owl:ObjectProperty ; rdfs:label "exercises output" ; rdfs:domain rdm:TestRun ;
    rdfs:range rdm:SourceFile ; rdfs:comment "The code a run exercises: requirement -> run -> code." .

rdm:finding a owl:DatatypeProperty ; rdfs:label "finding" ;
    rdfs:comment "A release-blocking finding, as the release gate reports it: of the risk rules on a risk (item-06-008), or about the whole record on the record (item-06-004)." .
rdm:riskWarning a owl:DatatypeProperty ; rdfs:label "risk warning" ; rdfs:domain rdm:Risk ;
    rdfs:comment "A warning of the risk rules on this risk, as the release gate reports it (item-06-008)." .

rdm:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "One risk of the register: hazard, situation, harm, scored severity × probability, its controls and residual (item-06-008)." .

rdm:controlledBy a owl:ObjectProperty ;
    rdfs:label "controlled by" ; rdfs:domain rdm:Risk ; rdfs:range rdm:Requirement ;
    rdfs:comment "A requirement that implements a control of this risk." .

rdm:hazard a owl:DatatypeProperty ; rdfs:label "hazard" ; rdfs:domain rdm:Risk .
rdm:situation a owl:DatatypeProperty ; rdfs:label "situation" ; rdfs:domain rdm:Risk .
rdm:harm a owl:DatatypeProperty ; rdfs:label "harm" ; rdfs:domain rdm:Risk .
rdm:severity a owl:DatatypeProperty ; rdfs:label "severity" ; rdfs:domain rdm:Risk .
rdm:probability a owl:DatatypeProperty ; rdfs:label "probability" ; rdfs:domain rdm:Risk .
rdm:level a owl:DatatypeProperty ; rdfs:label "level" ; rdfs:domain rdm:Risk ;
    rdfs:comment "The risk policy's level for severity × probability (evaluated, never typed)." .
rdm:recordedLevel a owl:DatatypeProperty ; rdfs:label "recorded level" ; rdfs:domain rdm:Risk ;
    rdfs:comment "The level the register states, if it states one." .
rdm:residualProbability a owl:DatatypeProperty ; rdfs:label "residual probability" ; rdfs:domain rdm:Risk .
rdm:residualLevel a owl:DatatypeProperty ; rdfs:label "residual level" ; rdfs:domain rdm:Risk ;
    rdfs:comment "The policy level after controls; the initial level when nothing controls the risk." .
rdm:acceptedBy a owl:DatatypeProperty ; rdfs:label "accepted by" ; rdfs:domain rdm:Risk .
rdm:acceptanceRationale a owl:DatatypeProperty ; rdfs:label "acceptance rationale" ; rdfs:domain rdm:Risk .
rdm:category a owl:DatatypeProperty ; rdfs:label "category" ; rdfs:domain rdm:Risk ;
    rdfs:comment "safety or security: the branch the risk was analysed on." .
rdm:stride a owl:DatatypeProperty ; rdfs:label "STRIDE category" ; rdfs:domain rdm:Risk .
rdm:linkedTo a owl:ObjectProperty ; rdfs:label "linked to" ; rdfs:domain rdm:Risk ; rdfs:range rdm:Risk ;
    rdfs:comment "Another risk this one bears on (a security threat and the safety risk it can cause)." .
rdm:residualSeverity a owl:DatatypeProperty ; rdfs:label "residual severity" ; rdfs:domain rdm:Risk .
rdm:residualDecision a owl:DatatypeProperty ; rdfs:label "residual decision" ; rdfs:domain rdm:Risk ;
    rdfs:comment "acceptable, accepted, needs acceptance, unacceptable, or not evaluated (a control lacks a passing test)." .
rdm:riskStatus a owl:DatatypeProperty ; rdfs:label "status" ; rdfs:domain rdm:Risk ;
    rdfs:comment "proposed (no person has approved the rating yet) or approved." .
rdm:declarationCount a owl:DatatypeProperty ; rdfs:label "declaration count" ;
    rdfs:comment "How many times the spec stamps this id (a requirement), or the record declares it (a risk); more than one is a conflict." .

rdm:status a owl:DatatypeProperty ;
    rdfs:label "status" ; rdfs:domain rdm:TestRun ;
    rdfs:comment "The executed result as Allure reported it (passed, failed, broken, skipped)." .

rdm:sha a owl:DatatypeProperty ;
    rdfs:label "commit sha" ; rdfs:domain prov:Activity .

rdm:includes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "includes" ; rdfs:domain rdm:Checklist ; rdfs:range rdm:Checklist ;
    rdfs:comment "The checklist includes every clause of another checklist (an include directive)." .

rdm:edition a owl:DatatypeProperty ;
    rdfs:label "edition" ; rdfs:domain rdm:Clause ;
    rdfs:comment "The edition a clause key is qualified with (62304:5.2.2.j@2015 -> 2015)." .

dcterms:references rdfs:label "references" ;
    rdfs:comment "A controlled document claims a clause with a [[KEY]] reference tag, or names a controlled document it relies on in its references frontmatter (item-06-015)." .
skos:notation rdfs:label "key" .
skos:definition rdfs:label "description" .
skos:inScheme rdfs:label "standard" .
skos:broader rdfs:label "parent clause" .
skos:member rdfs:label "member" .
dcterms:identifier rdfs:label "identifier" .
dcterms:title rdfs:label "title" .
prov:wasGeneratedBy rdfs:label "was generated by" .
prov:wasAssociatedWith rdfs:label "was associated with" .
prov:endedAtTime rdfs:label "ended at" .

dcterms:description rdfs:label "description" .
