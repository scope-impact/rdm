@prefix rdm:     <https://github.com/scope-impact/rdm/ns#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix oslc_rm: <http://open-services.net/ns/rm#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# RDM's vocabulary for the design record as a graph (DI-35). Standard terms are
# reused where they exist -- OSLC Requirements Management for requirements,
# Dublin Core for document metadata, PROV-O for commits and authors -- and an
# rdm: term is minted only where none fits.

rdm: a owl:Ontology ;
    rdfs:label "RDM design-record vocabulary" ;
    rdfs:comment "Classes and properties for a medical-device design history file projected from RDM's Markdown record." .

# --- Classes ----------------------------------------------------------------

rdm:UserNeed a owl:Class ;
    rdfs:label "User need" ;
    rdfs:comment "A validated journey the product exists to serve (registered in the V&V plan)." .

rdm:DesignInput a owl:Class ;
    rdfs:subClassOf oslc_rm:Requirement ;
    rdfs:label "Design input" ;
    rdfs:comment "A verifiable requirement (§820.30(c)), declared once by its owning bounded context." .

rdm:BoundedContext a owl:Class ;
    rdfs:label "Bounded context" ;
    rdfs:comment "A unit of design, captured in one kind: design document." .

rdm:Document a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Controlled document" ;
    rdfs:comment "A document with a frontmatter id, under version control." .

rdm:TestFile a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Test file" ;
    rdfs:comment "A test source file carrying verification tags." .

rdm:TestRun a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Test run" ;
    rdfs:comment "One executed test, as reported in an Allure result." .

# Gap analysis (DI-37). Checklists are data, never classes: a new standard is
# a new skos:ConceptScheme instance, a new checklist a new rdm:Checklist
# instance -- loaded from a file, with no change to this vocabulary.

rdm:Clause a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Checklist clause" ;
    rdfs:comment "One requirement of a standard, as a checklist item: skos:notation is its key (e.g. 62304:5.6.2), skos:definition its description, skos:inScheme its standard, skos:broader its parent clause." .

rdm:Checklist a owl:Class ;
    rdfs:subClassOf skos:Collection ;
    rdfs:label "Checklist" ;
    rdfs:comment "A named selection of clauses: skos:member lists its own items, rdm:includes the checklists it includes; its effective contents are rdm:includes*/skos:member." .

skos:ConceptScheme rdfs:label "Standard" ;
    rdfs:comment "A standard or regulation whose clauses checklists select from, named by the key prefix (62304, P11, FDA-SW, ...)." .

prov:Activity rdfs:label "Activity" .
prov:Agent rdfs:label "Agent" .

# --- Properties -------------------------------------------------------------

rdm:text a owl:DatatypeProperty ;
    rdfs:label "text" ; rdfs:domain rdm:DesignInput ; rdfs:range xsd:string .

rdm:tracesTo a owl:ObjectProperty ;
    rdfs:label "traces to" ; rdfs:domain rdm:DesignInput ; rdfs:range rdm:UserNeed ;
    rdfs:comment "The user need a design input refines." .

rdm:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies" ; rdfs:domain rdm:BoundedContext ; rdfs:range rdm:UserNeed .

rdm:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by" ; rdfs:domain rdm:DesignInput ; rdfs:range rdm:BoundedContext .

rdm:realises a owl:ObjectProperty ;
    rdfs:label "realises" ; rdfs:domain rdm:BoundedContext ; rdfs:range rdm:DesignInput ;
    rdfs:comment "A context that contributes to a design input another context owns." .

rdm:declaredIn a owl:ObjectProperty ;
    rdfs:label "declared in" ; rdfs:range rdm:Document .

rdm:describes a owl:ObjectProperty ;
    rdfs:label "describes" ; rdfs:domain rdm:Document ; rdfs:range rdm:BoundedContext .

rdm:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ; rdfs:domain rdm:Document .

rdm:path a owl:DatatypeProperty ;
    rdfs:label "path" ; rdfs:comment "Repository-relative path." .

rdm:verifies a owl:ObjectProperty ;
    rdfs:label "verifies" ; rdfs:domain rdm:TestFile ; rdfs:range rdm:DesignInput ;
    rdfs:comment "The test file carries a verification tag for the design input. A tag, not a verdict." .

rdm:exercises a owl:ObjectProperty ;
    rdfs:label "exercises" ; rdfs:domain rdm:TestRun ; rdfs:range rdm:DesignInput .

rdm:status a owl:DatatypeProperty ;
    rdfs:label "status" ; rdfs:domain rdm:TestRun ;
    rdfs:comment "The executed result as Allure reported it (passed, failed, broken, skipped)." .

rdm:sha a owl:DatatypeProperty ;
    rdfs:label "commit sha" ; rdfs:domain prov:Activity .

rdm:includes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "includes" ; rdfs:domain rdm:Checklist ; rdfs:range rdm:Checklist ;
    rdfs:comment "The checklist includes every clause of another checklist (an include directive)." .

rdm:edition a owl:DatatypeProperty ;
    rdfs:label "edition" ; rdfs:domain rdm:Clause ;
    rdfs:comment "The edition a clause key is qualified with (62304:5.2.2.j@2015 -> 2015)." .

dcterms:references rdfs:label "references" ;
    rdfs:comment "A controlled document claims a clause with a [[KEY]] reference tag." .
skos:notation rdfs:label "key" .
skos:definition rdfs:label "description" .
skos:inScheme rdfs:label "standard" .
skos:broader rdfs:label "parent clause" .
skos:member rdfs:label "member" .
dcterms:identifier rdfs:label "identifier" .
dcterms:title rdfs:label "title" .
prov:wasGeneratedBy rdfs:label "was generated by" .
prov:wasAssociatedWith rdfs:label "was associated with" .
prov:endedAtTime rdfs:label "ended at" .
